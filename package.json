{
  "name": "skillbridge",
  "version": "1.0.0",
  "description": "Cluster-based platform for educational institutions to share infrastructure, trainers, internships, and placement opportunities.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"node server/index.js\" \"npm run dev --prefix client\"",
    "build": "cd client && npm install && npm run build",
    "seed": "node server/seed.js"
  },
  "keywords": [
    "education",
    "cluster",
    "resource-sharing",
    "placement-management",
    "internships",
    "certifications"
  ],
  "author": "EduCluster Team",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "morgan": "^1.11.0",
    "vite": "^8.2.2"
  }
}
